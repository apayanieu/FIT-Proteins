# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class

# --- Environments ---
.env
.venv
env/
venv/
condaenv.*
*.yml~

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
*.egg

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDEs / editors ---
.vscode/
.idea/

# --- OS ---
.DS_Store

# --- Logs / outputs (TOP-LEVEL ONLY) ---
/outputs/
/logs/

# --- Data (keep raw, ignore processed) ---
data/processed/

# --- Large model / binary artefacts (but keep CSV + TXT in results/) ---
*.pt
*.npz
*.joblib
*.ckpt
*.pth
